__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/
# Arquivo de secrets local da máquina do dev (li_at, telegram api, etc.). Os
# arquivos por ambiente (.env.development/.homolog/.production) SÃO versionados —
# contêm só flags e config pública do Supabase (anon key é pública por design).
.env
# Overrides locais por ambiente (convenção do Vite) — nunca versionar.
.env*.local
build/
dist/
electron/release/
*.egg-info/
output/*
!output/.gitkeep
data/cache.sqlite*
# User-supplied Telegram API credentials (api_id/api_hash) — secret, never commit.
data/telegram_credentials.json
# Logs de build (artefatos transitórios do empacotamento).
*.log
