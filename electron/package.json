{
  "name": "beautiful-linkedin-desktop",
  "version": "0.1.6",
  "description": "Desktop UI (Electron + React) for Beautiful LinkedIn.",
  "author": "jpAoH Software Solutions",
  "copyright": "Copyright © 2026 jpAoH Software Solutions",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:clj": "cross-env BEAUTIFUL_LINKEDIN_SIDECAR=clj LINKEDIN_CDP_ENDPOINT=http://127.0.0.1:9223 electron-vite dev",
    "dev:java": "cross-env BEAUTIFUL_LINKEDIN_SIDECAR=java LINKEDIN_CDP_ENDPOINT=http://127.0.0.1:9223 electron-vite dev",
    "build": "electron-vite build",
    "build:dev": "electron-vite build --mode development",
    "build:homolog": "electron-vite build --mode homolog",
    "build:prod": "electron-vite build --mode production",
    "pack:win": "npm run build && electron-builder --win --dir",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:win:dev": "npm run build:dev && electron-builder --win nsis --config.appId=com.beautifullinkedin.desktop.dev --config.productName=\"Beautiful LinkedIn Dev\" --config.directories.output=release/dev",
    "dist:win:homolog": "npm run build:homolog && electron-builder --win nsis --config.appId=com.beautifullinkedin.desktop.homolog --config.productName=\"Beautiful LinkedIn Homolog\" --config.directories.output=release/homolog",
    "dist:win:prod": "npm run build:prod && electron-builder --win nsis --config.appId=com.beautifullinkedin.desktop --config.productName=\"Beautiful LinkedIn\" --config.directories.output=release/prod",
    "pack:mac": "npm run build && electron-builder --mac --dir",
    "dist:mac": "npm run build && electron-builder --mac dmg zip",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.12.7",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "cross-env": "^7.0.3",
    "electron": "^31.2.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^2.3.0",
    "jsdom": "^24.1.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "build": {
    "appId": "com.beautifullinkedin.desktop",
    "productName": "Beautiful LinkedIn",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist/beautiful-linkedin-sidecar",
        "to": "sidecar"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico",
      "signAndEditExecutable": true,
      "verifyUpdateCodeSignature": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business",
      "icon": "resources/icon.icns",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "dmg": {
      "sign": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
