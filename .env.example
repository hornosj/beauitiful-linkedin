BEAUTIFUL_LINKEDIN_MAX_RESULTS=20
BEAUTIFUL_LINKEDIN_SITE_TIMEOUT_SECONDS=8
BEAUTIFUL_LINKEDIN_SITE_MAX_PAGES=8

# Optional public search APIs. Leave blank to use DuckDuckGo only.
BRAVE_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_CX=
SERPER_API_KEY=
SEARXNG_BASE_URL=
PEOPLE_DATA_LABS_API_KEY=
CORESIGNAL_API_KEY=
APOLLO_API_KEY=
LUSHA_API_KEY=
SNOVIO_CLIENT_ID=
SNOVIO_CLIENT_SECRET=
# Optional server-side enrichment cost overrides (BRL per credit).
# Public provider APIs do not expose plan-specific credit pricing.
ENRICHMENT_COST_BRL_APOLLO=
ENRICHMENT_COST_BRL_LUSHA=
ENRICHMENT_COST_BRL_SNOVIO=
ENRICHMENT_COST_BRL_PDL=
APIFY_API_KEY=
BEAUTIFUL_LINKEDIN_CACHE_PATH=data/cache.sqlite
BEAUTIFUL_LINKEDIN_CACHE_TTL_SECONDS=
BEAUTIFUL_LINKEDIN_WEB_QUERY_LIMIT=32
BEAUTIFUL_LINKEDIN_PROVIDER_TIMEOUT_SECONDS=35
# Cookie li_at para modos cookie / people_search / browser.
# Se LINKEDIN_LI_AT_COOKIE estiver vazio o sistema tenta detectar do navegador padrão
# do Windows (auto). No Chrome/Edge 127+ o cookie é criptografado com ABE — para
# ler automaticamente, instale: `pip install rookiepy`. Em Chrome 130+ pode pedir
# admin no Windows. Como alternativa, copie o valor de `li_at` (DevTools >
# Application > Cookies) direto pra cá.
LINKEDIN_LI_AT_COOKIE=
LINKEDIN_COOKIE_BROWSER=auto

# Risky mode (Playwright, logged-in browser). Optional. Requires:
#   pip install 'beautiful-linkedin[risky]'
#   playwright install chromium
# Reuses LINKEDIN_LI_AT_COOKIE / LINKEDIN_COOKIE_BROWSER above.
# BEAUTIFUL_LINKEDIN_PLAYWRIGHT_USER_DATA_DIR keeps a persistent Chromium profile
# (cookies, fingerprint stability) and reduces detection vs ephemeral contexts.
BEAUTIFUL_LINKEDIN_PLAYWRIGHT_USER_DATA_DIR=
BEAUTIFUL_LINKEDIN_PLAYWRIGHT_HEADLESS=true

# Optional crawl4ai + LLM fallback for LinkedIn People extraction.
# Triggered only when the heuristic extractor returns empty/incomplete records.
# Requires: pip install 'beautiful-linkedin[crawl4ai]'
OPENAI_API_KEY=
LINKEDIN_LLM_EXTRACTION_MODEL=openai/gpt-4o-mini
LINKEDIN_LLM_EXTRACTION_ENABLED=true
LINKEDIN_LLM_EXTRACTION_TIMEOUT_SECONDS=45

# CDP — caminho recomendado para o provider linkedin_people_search.
# Quando o Chrome está aberto com `--remote-debugging-port=9222`, o app
# conecta na sessão real do usuário via Chrome DevTools Protocol. Não
# desloga você do LinkedIn (mesmo fingerprint, mesma sessão). Se não estiver
# rodando, o app cai pro fallback com li_at (que pode deslogar).
LINKEDIN_CDP_ENDPOINT=http://127.0.0.1:9222
LINKEDIN_CDP_ENABLED=true

# Telegram phone lookup provider.
# Used by internal phone enrichment to query @ConsultoriaGonzalesbot with:
#   /nome Nome Completo
# Get api_id/api_hash at https://my.telegram.org > API development tools.
BEAUTIFUL_LINKEDIN_TELEGRAM_API_ID=
BEAUTIFUL_LINKEDIN_TELEGRAM_API_HASH=
BEAUTIFUL_LINKEDIN_TELEGRAM_SESSION_NAME=data/telegram_phone_lookup
BEAUTIFUL_LINKEDIN_TELEGRAM_PHONE_BOT=@ConsultoriaGonzalesbot

# Telegram GROUP phone lookup provider.
# Posts "/nome Nome Completo" in a public group (e.g. CONSULTASGRATIS4NV)
# and harvests every reply that arrives during the capture window.
# Reuses BEAUTIFUL_LINKEDIN_TELEGRAM_API_ID / API_HASH above.
# Leave BEAUTIFUL_LINKEDIN_TELEGRAM_GROUP_USERNAME blank to disable.
# WARNING: posting in public groups can earn a Telegram ban — keep the
# throttle conservative. Accept "@CONSULTASGRATIS4NV", "CONSULTASGRATIS4NV"
# or "https://t.me/CONSULTASGRATIS4NV".
BEAUTIFUL_LINKEDIN_TELEGRAM_GROUP_USERNAME=
BEAUTIFUL_LINKEDIN_TELEGRAM_GROUP_SESSION_NAME=data/telegram_group_phone_lookup
BEAUTIFUL_LINKEDIN_TELEGRAM_GROUP_CAPTURE_SECONDS=30
BEAUTIFUL_LINKEDIN_TELEGRAM_GROUP_THROTTLE_SECONDS=5

# Human-paced timing for the unified /telegram-phone flow.
# Post-send: uniform jitter (min, max) applied right after pressing Enter
# on every Gonzales/Findex composer message. Inter-lead: uniform pause
# between processing two consecutive leads in the loop — keeps the bots
# from rate-limiting an operator who clicks "Pegar telefone via Telegram"
# on a batch of 10 leads at once.
BEAUTIFUL_LINKEDIN_TELEGRAM_POST_SEND_MIN=4.5
BEAUTIFUL_LINKEDIN_TELEGRAM_POST_SEND_MAX=6.5
BEAUTIFUL_LINKEDIN_TELEGRAM_INTER_LEAD_MIN=3.0
BEAUTIFUL_LINKEDIN_TELEGRAM_INTER_LEAD_MAX=6.0

# Quanto tempo o driver Gonzales aguarda a resposta do bot (botão
# "Ver Resultado Completo") antes de desistir. Contado APÓS o post-send
# jitter. Aumente se o bot estiver demorando mais que o normal — o sintoma
# é o log dizer "no response" mas a UI mostrar o botão renderizado.
BEAUTIFUL_LINKEDIN_TELEGRAM_GON_ABORT_TIMEOUT=45.0
