# === Versão HOMOL (modo homolog) ===
# Igual à DEV (Telegram visível), porém com login Supabase para validação.
# As credenciais serão configuradas DEPOIS — preencha as duas linhas abaixo com
# o projeto de homologação e mude VITE_SUPABASE_AUTH_REQUIRED para 1.
# Enquanto ficarem em branco, a homol se comporta como a dev (sem login).
VITE_FEATURE_TELEGRAM=1
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_AUTH_REQUIRED=
